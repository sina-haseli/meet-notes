{
  "manifest_version": 3,
  "name": "Meet Notes",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Record Google Meet and get Persian/English meeting notes, summaries and transcripts.",
  "permissions": ["tabCapture", "offscreen", "storage", "unlimitedStorage", "notifications", "downloads", "activeTab"],
  "host_permissions": ["https://openrouter.ai/*"],
  "optional_host_permissions": ["http://127.0.0.1:47821/*"],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": {
    "default_title": "Meet Notes",
    "default_popup": "dist/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["dist/speakerLog.js"],
      "run_at": "document_idle"
    }
  ]
}
